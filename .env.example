# Copy to `.env` and fill in. Never commit the filled-in file.
#
# The CLI reads these on startup. Every value can also be supplied with the
# matching CLI flag, which always wins over the environment.

# Soroban RPC endpoint. Must be the endpoint for the network you intend to
# write to. Example testnet value: https://soroban-testnet.stellar.org
SPLITSTREAM_RPC_URL=

# Network passphrase. MUST match SPLITSTREAM_RPC_URL's network or every signed
# transaction will be rejected as a bad network id.
#   testnet: Test SDF Network ; September 2015
#   mainnet: Public Global Stellar Network ; September 2015
SPLITSTREAM_NETWORK_PASSPHRASE=

# splitstream-core vault contract (C...). Set after deployment.
SPLITSTREAM_VAULT_CONTRACT_ID=

# Payout token contract (C...). Set after token setup.
SPLITSTREAM_TOKEN_CONTRACT_ID=

# TESTNET-DEV ONLY. INSECURE. Never set this on mainnet and never commit it.
# The CLI refuses to use this signer when the network passphrase is mainnet.
SPLITSTREAM_DEV_SECRET_KEY=

# Optional. GitHub token used by `splitstream simulate` to read PRs without
# hitting the anonymous rate limit. Needs `public_repo` (or `repo`) scope.
GITHUB_TOKEN=

# Optional. Path to a JSON config file used when distributing the CLI to
# machines that do not use a .env file. See README for the schema.
SPLITSTREAM_CONFIG=
